---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard"
import StackCard from "@components/StackCard.astro"
import { SITE, SOCIALS } from "@consts"
import TwinklingStars from "@components/TwinklingStars.astro"
import MeteorShower from "@components/MeteorShower.astro"

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,3)

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,4)

const backendStack = [
  { 
    text: "Java 21 LTS", 
    icon: "java", 
    href: "https://dev.java/" 
  },
  { 
    text: "Spring Boot 3", 
    icon: "spring", 
    href: "https://spring.io/projects/spring-boot" 
  },
  { 
    text: "Apache Kafka", 
    icon: "kafka", 
    href: "https://kafka.apache.org" 
  },
  { 
    text: "Redis", 
    icon: "redis", 
    href: "https://redis.io" 
  },
  { 
    text: "PostgreSQL", 
    icon: "postgresql", 
    href: "https://www.postgresql.org" 
  },
  { 
    text: "Docker", 
    icon: "docker", 
    href: "https://www.docker.com" 
  },
  { 
    text: "AWS Cloud", 
    icon: "aws", 
    href: "https://aws.amazon.com" 
  },
]

const aiStack = [
  { 
    text: "Python & LLMs", 
    icon: "python", 
    href: "https://www.python.org" 
  },
  { 
    text: "Local Models (Ollama)", 
    icon: "python", 
    href: "https://ollama.ai" 
  },
  { 
    text: "Knowledge Graphs", 
    icon: "python", 
    href: "https://github.com/nedder3" 
  },
  { 
    text: "Multi-Agent Swarms", 
    icon: "python", 
    href: "https://github.com/nedder3" 
  },
]
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>

  <!-- Light Mode: Particles -->
  <div class='absolute inset-0 block dark:hidden'>
    <div id='particles1' class='fixed inset-0'></div>
    <div id='particles2' class='fixed inset-0'></div>
    <div id='particles3' class='fixed inset-0'></div>
  </div>

  <!-- Dark Theme: Stars -->
  <div class='absolute inset-0 bg-[#0b0f17] hidden dark:block'>
    <div id='stars1' class='fixed inset-0'></div>
    <div id='stars2' class='fixed inset-0'></div>
    <div id='stars3' class='fixed inset-0'></div>
  </div>

  <!-- Dark Theme: Twinkling Stars / Metors -->
  <div id="galaxy" class="fixed inset-0">
    <div class="hidden dark:block">
      <TwinklingStars/>
      <MeteorShower/>
    </div>
  </div>

  <script is:inline src="/js/bg.js"></script>
  
  <!-- HERO -->
  <section class="relative min-h-[85vh] w-full flex items-center justify-center">
    <div id="planetcont" class='animate absolute inset-0 top-1/4 overflow-hidden pointer-events-none'>
      <div id="crescent" class='absolute top-0 left-1/2 -translate-x-1/2 w-[250vw] min-h-[100vh] aspect-square rounded-full p-[1px] bg-gradient-to-b from-sky-500/20 dark:from-sky-400/30 from-0% to-transparent to-10%'>
        <div id="planet" class='w-full h-full bg-white dark:bg-[#0b0f17] rounded-full p-[1px] overflow-hidden flex justify-center'>
          <div id="blur" class='w-full h-24 rounded-full bg-sky-500/10 dark:bg-sky-400/15 blur-3xl'/>
        </div>
      </div>
    </div>

    <div class="animate relative w-full max-w-screen-md mx-auto p-5 text-center z-10 py-16">
      <!-- Live Status Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/25 mb-6 shadow-sm">
        <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Open to Worldwide Remote Roles (USD) · EF SET C2 Certified</span>
      </div>

      <h1 class='text-4xl md:text-5xl lg:text-6xl font-bold uppercase tracking-tight text-slate-900 dark:text-slate-50'>
        Ariel Jaime
      </h1>

      <p class='text-lg md:text-xl font-semibold text-sky-600 dark:text-sky-400 mt-3'>
        Senior Backend Engineer & Distributed AI Systems Architect
      </p>

      <p class='text-sm md:text-base text-slate-700 dark:text-slate-300 mt-3 max-w-xl mx-auto leading-relaxed'>
        <strong>10 years of software engineering experience</strong>, specializing for the past <strong>6+ years in enterprise Java, high-concurrency systems, and autonomous AI architectures</strong>.
      </p>

      <p class='text-xs md:text-sm text-slate-500 dark:text-slate-400 mt-2 max-w-lg mx-auto'>
        Java 21 LTS · High Concurrency & Virtual Threads · Multi-Agent Swarms · Knowledge Graphs
      </p>

      <div id="ctaButtons" class='flex flex-wrap gap-3.5 justify-center mt-8'>
        <a href='/projects' class='py-2.5 px-5 rounded-lg text-xs md:text-sm font-semibold bg-sky-600 hover:bg-sky-500 text-white dark:bg-sky-500 dark:hover:bg-sky-400 dark:text-slate-950 shadow-md shadow-sky-500/20 transition-all duration-200'>
          Explore Systems & Projects
        </a>
        <a href='/work' class='py-2.5 px-5 rounded-lg text-xs md:text-sm font-medium border border-slate-300 dark:border-slate-700 bg-white/50 dark:bg-slate-900/40 hover:bg-slate-100 hover:dark:bg-slate-800 text-slate-800 dark:text-slate-200 transition-all duration-200'>
          View Experience
        </a>
      </div>
    </div>
  </section>

  <div class="relative bg-white dark:bg-[#0b0f17]">
    <div class="mx-auto max-w-screen-sm p-5 space-y-20 pb-20">

      <!-- About Section -->
      <section class="animate">
        <div class="space-y-4 text-slate-700 dark:text-slate-300 leading-relaxed text-sm md:text-base">
          <p>
            I am a <strong class="text-slate-900 dark:text-slate-100">Senior Backend Engineer</strong> and <strong class="text-slate-900 dark:text-slate-100">Distributed AI Systems Architect</strong> with a decade in IT and 6+ years designing high-throughput, mission-critical systems in enterprise Java environments.
          </p>
          <p>
            Currently serving as <strong class="text-slate-900 dark:text-slate-100">Squad Senior / Tech Lead & Mentor at Teamcubation</strong>, where I guide development squads and mentor senior engineers across modern cloud architectures, Java 21, microservices, and agentic AI workflows.
          </p>
          <p>
            My engineering practice bridges two mission-critical disciplines:
          </p>
          <ul class="space-y-2.5 pl-2">
            <li class="flex items-start gap-2.5">
              <span class="text-sky-500 font-bold">▹</span>
              <span><strong class="text-slate-900 dark:text-slate-100">Distributed Infrastructure Primitives:</strong> Fault-tolerant key-value caches with Vector Clocks, WAL durability with CRC32 integrity, and lock-free CAS event buses built for zero thread contention under heavy workloads.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-sky-500 font-bold">▹</span>
              <span><strong class="text-slate-900 dark:text-slate-100">Autonomous Multi-Agent AI Systems:</strong> Multi-agent swarms with strict Single Responsibility (SRP), automated Red/Green TDD quality gates, knowledge graphs exceeding 33,000 nodes, and anti-hallucination deterministic LLM extraction pipelines.</span>
            </li>
          </ul>
        </div>
      </section>

      <!-- Tech Stack Section (Structured by Layers) -->
      <section class="animate">
        <div class="space-y-6">
          <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
            <h2 class="font-semibold text-slate-900 dark:text-slate-100 tracking-tight text-lg">
              Core Technologies & Infrastructure
            </h2>
            <span class="text-xs font-mono text-slate-500">Categorized Stack</span>
          </div>

          <!-- Layer 1: Backend & Distributed Core -->
          <div class="space-y-2.5">
            <h3 class="text-xs font-mono uppercase tracking-wider text-sky-600 dark:text-sky-400 font-semibold">
              01 // Backend & Distributed Core
            </h3>
            <div class="flex flex-wrap items-center gap-2.5">
              {backendStack.map(item => (
                <StackCard 
                  text={item.text}
                  icon={item.icon}
                  href={item.href}
                />
              ))}
            </div>
          </div>

          <!-- Layer 2: Agentic AI & Systems -->
          <div class="space-y-2.5 pt-2">
            <h3 class="text-xs font-mono uppercase tracking-wider text-sky-600 dark:text-sky-400 font-semibold">
              02 // Agentic AI & Systems Architecture
            </h3>
            <div class="flex flex-wrap items-center gap-2.5">
              {aiStack.map(item => (
                <StackCard 
                  text={item.text}
                  icon={item.icon}
                  href={item.href}
                />
              ))}
            </div>
          </div>

          <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 font-mono">
            Hexagonal Architecture · CQRS / Event Sourcing · Concurrency & Virtual Threads · Multi-Agent Swarms · Knowledge Graphs
          </p>
        </div>
      </section>

      <!-- Project Preview Section -->
      <section class="animate">
        <div class="space-y-4">
          <div class="flex justify-between items-center border-b border-slate-200 dark:border-slate-800 pb-3">
            <h2 class="font-semibold text-slate-900 dark:text-slate-100 tracking-tight text-lg">
              Featured Systems & Architecture Projects
            </h2>
            <a href="/projects" class="text-xs font-semibold text-sky-600 dark:text-sky-400 hover:underline underline-offset-4 flex items-center gap-1">
              All projects &rarr;
            </a>
          </div>
          <ul class="space-y-3.5 pt-2">
            {projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))}
          </ul>
        </div>
      </section>

      {posts.length > 0 && (
        <!-- Blog Preview Section -->
        <section class="animate">
          <div class="space-y-4">
            <div class="flex justify-between items-center border-b border-slate-200 dark:border-slate-800 pb-3">
              <h2 class="font-semibold text-slate-900 dark:text-slate-100 tracking-tight text-lg">
                Architecture Notes & Articles
              </h2>
              <a href="/blog" class="text-xs font-semibold text-sky-600 dark:text-sky-400 hover:underline underline-offset-4 flex items-center gap-1">
                All articles &rarr;
              </a>
            </div>
            <ul class="space-y-3.5 pt-2">
              {posts.map((post) => (
                <li>
                  <ArrowCard entry={post} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <!-- Contact Section -->
      <section class="animate">
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800/80 bg-slate-50 dark:bg-slate-900/40">
          <h2 class="font-semibold text-slate-900 dark:text-slate-100 tracking-tight text-lg">
            Let's Connect
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 mt-1.5">
            Available for worldwide remote senior backend engineering, distributed systems architecture consulting, and agentic AI systems design (USD).
          </p>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-5">
            {SOCIALS.map(social => (
              <a href={social.HREF} target="_blank" class="flex flex-col p-3 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 hover:border-sky-500/50 hover:dark:border-sky-400/50 transition-all duration-200">
                <span class="text-xs uppercase font-mono text-slate-500">{social.NAME}</span>
                <span class="text-xs font-medium text-slate-900 dark:text-slate-200 truncate mt-1">{social.TEXT}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    </div>
  </div>
</PageLayout>
