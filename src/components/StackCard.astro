---
type Props = {
  text: string
  icon: string
  href: string
}

const { text, icon, href } = Astro.props
---

<a href={href} target="_blank" class="w-fit px-3 py-2 group rounded-lg border flex gap-2.5 items-center border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/50 hover:bg-slate-50 hover:dark:bg-slate-800/80 hover:border-sky-500/40 dark:hover:border-sky-400/40 shadow-sm transition-all duration-300 ease-in-out">
  <svg height={20} width={20} class="shrink-0 transition-transform duration-300 group-hover:scale-110">
    <use href={`/stack.svg#${icon}`}></use>
  </svg>
  <span class="text-sm font-medium text-slate-700 dark:text-slate-300 group-hover:text-slate-950 dark:group-hover:text-sky-300 transition-colors duration-200">
    {text}
  </span>
</a>
