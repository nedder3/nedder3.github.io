---
import Container from "@components/Container.astro"
---

<footer class="relative bg-white dark:bg-[#0b0f17] border-t border-slate-200 dark:border-slate-800">
  <div class="animate">
    <section class="py-5">
      <Container size="md">
        <div class="flex items-center justify-center sm:justify-end">
          <button id="back-to-top" aria-label="Back to top of page" class="group flex w-fit p-2 gap-2 text-xs font-medium items-center border rounded-lg hover:bg-slate-100 hover:dark:bg-slate-800 border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors duration-200">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rotate-90">
              <line x1="19" y1="12" x2="5" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-3 group-hover:translate-x-0 transition-all duration-200" />
              <polyline points="12 19 5 12 12 5" class="translate-x-1 group-hover:translate-x-0 transition-all duration-200" />
            </svg>
            <div>
              Back to top
            </div>
          </button>
        </div>
      </Container>
    </section>
  
    <section class="py-5 overflow-hidden whitespace-nowrap border-t border-slate-200 dark:border-slate-800/80">
      <Container size="md">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 items-center">
          <div class="flex flex-col items-center sm:items-start">
            <a href="/" class="font-bold tracking-tight text-slate-900 dark:text-slate-100 hover:text-sky-600 dark:hover:text-sky-400 transition-colors duration-200">
              Ariel Jaime
            </a>
            <span class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Senior Backend Engineer & Distributed AI Systems Architect
            </span>
          </div>
          <div class="flex gap-2 justify-center sm:justify-end items-center text-xs text-slate-600 dark:text-slate-400 font-mono">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
            </span>
            All systems verified & passing
          </div>
        </div>
      </Container>
    </section>
  
    <section class="py-5 overflow-hidden whitespace-nowrap border-t border-slate-200 dark:border-slate-800/80">
      <Container size="md">
        <div class="h-full grid grid-cols-1 sm:grid-cols-2 gap-3 items-center">
          <div class="order-2 sm:order-1 flex flex-col items-center justify-center sm:items-start">
            <div class="legal text-xs text-slate-500 dark:text-slate-400">
              &copy; {new Date().getFullYear()} Ariel Jaime. All rights reserved.
            </div>
          </div>
          <div class="order-1 sm:order-2 flex justify-center sm:justify-end">
            <div class="flex flex-wrap gap-2 text-xs text-slate-500 dark:text-slate-400">
              <a href="/legal/terms" class="hover:text-slate-900 dark:hover:text-slate-100 transition-colors duration-200">
                Terms
              </a>
              <span>&bull;</span>
              <a href="/legal/privacy" class="hover:text-slate-900 dark:hover:text-slate-100 transition-colors duration-200">
                Privacy
              </a>
            </div>
          </div>
        </div>
      </Container>
    </section>
  </div>
</footer>

<script is:inline>
  function inintializeBackToTop() {
    const backToTop = document.getElementById("back-to-top")
    backToTop?.addEventListener("click", () => {
      window.scrollTo({
        top: 0,
        behavior: "smooth"
      })
    })
  }

  document.addEventListener("astro:after-swap", inintializeBackToTop)
  inintializeBackToTop()
</script>
